# ============================================================================
# Rogue-Text — Environment Variables TEMPLATE
# ============================================================================
#
# HOW TO USE:
#   1. Copy this file and rename the copy to  .env.local
#   2. Paste your real Groq API key after the equals sign
#   3. NEVER commit .env.local  — it is already listed in .gitignore
#
#   cp .env.example .env.local        (macOS / Linux / Git Bash)
#   copy .env.example .env.local      (Windows CMD)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# Get a free key at: https://console.groq.com/keys
# ============================================================================


# ---------------------------------------------------------------------------
# REQUIRED — Groq API key. Used ONLY by the serverless proxy at /api/dm.js.
# Never expose this in client-side JavaScript.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_real_groq_api_key_here


# ---------------------------------------------------------------------------
# OPTIONAL — Groq model ID for the Dungeon Master.
#
# NOTE: meta-llama/llama-4-scout-17b-16e-instruct was SHUT DOWN by Groq on
# 2026-07-17 (removed from the free/developer tier). The default below is
# Groq's recommended replacement. Other valid options at time of writing:
#   openai/gpt-oss-120b        (recommended — strong JSON adherence)
#   openai/gpt-oss-20b         (fastest / cheapest)
#   qwen/qwen3.6-27b           (alternative recommended migration target)
# See current lineup: https://console.groq.com/docs/models
# ---------------------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b


# ---------------------------------------------------------------------------
# OPTIONAL — Generation tuning. Safe defaults are used if omitted.
# ---------------------------------------------------------------------------
# Lower = more literal and rule-following. Required for reliable JSON.
GROQ_TEMPERATURE=0.85
# Hard ceiling on DM response length (tokens).
GROQ_MAX_TOKENS=900
# Request timeout in milliseconds before the proxy gives up.
GROQ_TIMEOUT_MS=30000